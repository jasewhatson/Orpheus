<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background audio so playback continues with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Allow plain-HTTP connections to the user-configured music server (LAN,
	     Tailscale 100.64.0.0/10 CGNAT, or MagicDNS .ts.net). The address is
	     user-supplied and may not be RFC-1918, so ATS is fully disabled.
	     NOTE: do NOT also add NSAllowsLocalNetworking — on iOS 10+ its presence
	     makes the system ignore NSAllowsArbitraryLoads (the bug that blocked
	     http://100.x Tailscale addresses). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
