<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background audio so playback continues with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Allow plain-HTTP connections to the user-configured music server.
	     NSAllowsLocalNetworking covers RFC-1918 LAN addresses (192.168.x.x) and
	     .local hosts; NSAllowsArbitraryLoads additionally covers Tailscale's
	     100.64.0.0/10 (CGNAT) addresses and MagicDNS .ts.net hostnames, since
	     the server address is user-supplied and may not be RFC-1918. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
